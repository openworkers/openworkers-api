{
  "name": "openworkers-api",
  "version": "1.7.1",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/openworkers/openworkers-api.git"
  },
  "private": true,
  "scripts": {
    "start": "bun server.ts",
    "dev": "bun x --bun vite dev",
    "build": "NODE_ENV=production bun x --bun vite build",
    "preview": "bun x --bun vite preview --port 7000",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "bun test",
    "lint": "prettier --write .",
    "format": "prettier --write .",
    "generate-types": "bun scripts/generate-types.ts",
    "clean": "rimraf .svelte-kit build node_modules",
    "deploy:dev": "bun run build && ow dev worker upload openworkers-api ./build",
    "deploy:local": "bun run build && ow local worker upload openworkers-api ./build",
    "deploy:main": "bun run build && ow main worker upload openworkers-api ./build"
  },
  "dependencies": {
    "@openworkers/croner-wasm": "^0.3.1",
    "aws4fetch": "^1.0.20",
    "kysely": "^0.28.11",
    "p-limit": "^7.2.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@openworkers/adapter-sveltekit": "^0.5.6",
    "@openworkers/workers-types": "^0.1.9",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/bun": "^1.3.9",
    "fflate": "^0.8.2",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "zod-to-ts": "^2.0.0"
  }
}
